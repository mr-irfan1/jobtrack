# Supabase configuration for JobTrack.
#
# Copy this file to .env.local and fill in the values from your Supabase
# project's API settings (Project Settings -> API). .env.local is gitignored
# and must never be committed.
#
# Use ONLY the anon / publishable key here. Never put the service_role key in
# the frontend — it bypasses Row Level Security.

VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
